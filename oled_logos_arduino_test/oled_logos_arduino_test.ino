#define OUTPUT_ENABLE 7

char array[220] = { 5 };

void printArray(char *newArray) {
  Serial.println(array);
}

void setup() {
  Serial.begin(115200);
  pinMode(OUTPUT_ENABLE, OUTPUT);
  digitalWrite(OUTPUT_ENABLE, true);

  // Dont know what this does
  // SSD1306_SWITCHCAPVCC = generate display voltage from 3.3V internally
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {  // Address 0x3C for 128x32
    Serial.println(F("SSD1306 allocation failed"));
    for (;;)
      ;  // Don't proceed, loop forever
  } else {
    Serial.println("passed");
  }
  display.clearDisplay();
  display.drawBitmap(0, 20, practLogo3, logoW3, logoH3, 1);  //(x , y bitMap, width, height, color)
                                                             //   display.drawBitmap(4, 20, panLogo, pxWidth, pxHeight, 1);  //(x , y bitMap, width, height, color)
  display.display();
  // delay(2000);
  delay(500);
  delay(500);
  display.invertDisplay(true);
  delay(500);
  //  display.invertDisplay(false);
  //  delay(500);
  //  display.invertDisplay(true);
  // delay(1000);
  display.invertDisplay(false);
  printArray(array);
}

void loop() {
  display.invertDisplay(false);
  delay(4000);
  display.invertDisplay(true);
  delay(4000);
}
